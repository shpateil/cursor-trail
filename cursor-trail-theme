#!/bin/bash
# cursor-trail-theme — темы и управление следом за курсором
# тема = набор строк в config.toml; бинарь читает конфиг сам

CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cursor-trail"
CFG="$CFG_DIR/config.toml"
BIN="$HOME/.local/bin/cursor-trail"
STATE_DIR="$HOME/.local/share/cursor-trail"
FLAG="$STATE_DIR/disabled"
STATE="$STATE_DIR/theme"

mkdir -p "$CFG_DIR" "$STATE_DIR"

